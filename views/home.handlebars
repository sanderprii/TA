<!-- register-training.handlebars -->


<div class="container1 mt-4">
    <h1 id="register-home-training">Register for Training</h1>

    <div class="mb-3 position-relative">

        <input type="text" class="form-control" id="affiliateSearch" placeholder="Type affiliate name...">
        <div id="affiliateSuggestions" class="list-group position-absolute w-100" style="z-index: 1000;"></div>
    </div>


    <div id="affiliateInfo" style="display:none;">
        <h3>Affiliate Information</h3>
        <p><strong>Name:</strong> <span id="affName"></span></p>
        <p><strong>Address:</strong> <span id="affAddress"></span></p>
        <p><strong>Training Type:</strong> <span id="affTrainingType"></span></p>
        <h4>Trainers:</h4>
        <ul id="affTrainers"></ul>

        <button id="viewScheduleBtn" class="btn btn-secondary mt-3">View Schedule</button>
        <button id="viewPlansBtn" class="btn btn-info mt-3">View Plans</button>
        <button id="addHomeAffiliate" class="btn btn-secondary mt-3">Add for home gym</button>
        <button id="removeHomeAffiliate" class="btn btn-secondary mt-3">Remove home gym</button>
    </div>

    <div id="scheduleContainer" style="display:none;" class="mt-4">
        <div class="container-fluid1 p-5 text-center">
            <h2>Schedule</h2>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <!-- Vasakul Previous Week nupp -->
                <button id="prev-week" class="btn btn-secondary">Previous Week</button>

                <!-- Keskel Current Week -->


                <!-- Paremal Next Week ja Add Training nupud -->
                <div class="d-flex align-items-center">
                    <button id="next-week" class="btn btn-secondary me-2">Next Week</button>

                </div>
            </div>
            <span id="current-week" class="h5 text-center"></span>
            <!-- Päevade nupud väikese ekraani jaoks -->
            <div id="day-buttons" class="d-flex justify-content-between bg-dark rounded-pill" style="display:none;">
                <!-- Siia lisame dünaamiliselt 7 päeva nupud -->
            </div>
            <div id="schedule"></div>
        </div>
    </div>
    <!-- PLAANIDE konteiner -->
    <div id="plansContainer" style="display:none;" class="mt-4">
        <h2>Affiliate Plans</h2>
        <!-- siia renderdame plaanide nupud -->
        <div id="plansList" class="d-flex flex-wrap"></div>
    </div>
</div>

<!-- Modal for class details and registration -->
<div class="modal fade" id="classModal" tabindex="-1" aria-labelledby="classModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="classModalLabel" class="modal-title">Class Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="classCapacityInfo"><strong>Free spots:</strong> <span id="freeSpots"></span> / <strong>Class
                    capacity:</strong> <span id="classCapacity"></span></p>
                <p><strong>Training Name:</strong> <span id="modalTrainingName"></span></p>
                <p><strong>Time:</strong> <span id="modalTime"></span></p>
                <div id="classTrainer">
                    <p><strong>Trainer:</strong> <span id="modalTrainer"></span></p>
                </div>
                <div id="classLocation">
                    <p><strong>Location:</strong> <span id="modalLocation"></span></p>
                </div>
                <input type="hidden" id="modalClassId">
                <div class="bg-light border p-3" id="wodInfo">
                    <div id="wodName3">
                        <p><strong>Wod Name:</strong> <span id="wodName"></span></p>
                    </div>
                    <div id="wodType3">
                        <p><strong>Wod Type:</strong> <span id="wodType"></span></p>
                    </div>
                    <div id="wodDescription">
                        <p><strong>Description:</strong>

                        <div id="modalDescription"></div>
                        </p>
                    </div>
                    <input type="hidden" id="modalClassId">

                    <div id="addScoreDiv" class="bg-light border p-3">
                        <div>
                            <label for="score"><strong>Enter your score:</strong></label>
                        </div>

                        <div class="d-flex justify-content-around">

                            <label for="rx">
                                <input type="radio" class="" name="score-type" value="rx" id="rx">Rx</label>
                            <label for="sc">
                                <input type="radio" class="" name="score-type" value="sc" id="sc">Sc</label>
                            <label for="beg">
                                <input type="radio" class="" name="score-type" value="beg" id="beg">Beg</label>
                        </div>
                        <div>
                            <input type="text" class="form-control" id="score" placeholder="Enter your score">
                        </div>
                    </div>
                </div>

                <div id="planDiv">
                    <label id="plan-label">Choose plan for registation</label>
                    <div id="planSelect">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="addScore" type="button" class="btn btn-primary">Add Score</button>
                <button id="addToTrainings" type="button" class="btn btn-primary" style="display: none">Add Training
                </button>
                <button id="editScore" type="button" class="btn btn-primary" style="display:none;">Edit Score</button>
                <button id="showLeaderboard" type="button" class="btn btn-primary">Show Leaderboard</button>
                <button id="registerForClassBtn" type="button" class="btn btn-primary">Register for Class</button>
                <button id="cancelClassBtn" type="button" class="btn btn-danger" style="display:none;">Cancel Training
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
</div>

<!-- Modal for plan info (read-only) -->
<div class="modal fade" id="planInfoModal" tabindex="-1" aria-labelledby="planInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="planInfoModalLabel" class="modal-title">Plan Info</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Plan Name:</strong> <span id="modalPlanName"></span></p>
                <p><strong>Validity (Days):</strong> <span id="modalPlanDays"></span></p>
                <p><strong>Price:</strong> $<span id="modalPlanPrice"></span></p>
                <p><strong>Additional Info:</strong></p>
                <p id="modalPlanData"></p>
            </div>
            <div class="modal-footer">
                <button id="buyPlanBtn" type="button" class="btn btn-success">Buy plan</button>
                <!-- Ainult sulgemise nupp -->
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Method Modal (NEW) -->
<div class="modal fade" id="paymentMethodModal" tabindex="-1" aria-labelledby="paymentMethodModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="paymentMethodModalLabel" class="modal-title">Choose Payment Method</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex justify-content-around">
                <button id="onAppBtn" class="btn btn-success">On App</button>
                <button id="byCardBtn" class="btn btn-primary">By Card</button>
            </div>
        </div>
    </div>
</div>

<!-- Leaderboard Modal -->
<div class="modal fade" id="leaderboardModal" tabindex="-1" aria-labelledby="leaderboardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg"> <!-- use modal-lg if you want a larger dialog -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="leaderboardModalLabel" class="modal-title">Leaderboard</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="leaderboardBody">
                <!-- We'll dynamically fill this with data (e.g., a table or list) -->
                <p>Loading leaderboard...</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<script src="/register-class.js">


</script>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Rubik&display=swap"
          rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/flaticon/font/flaticon.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css' rel='stylesheet'/>

</head>
<header>
    <div class="container-fluid bg-dark px-0">
        <div class="row gx-0">
            <div class="col-lg-3 bg-dark d-none d-lg-block">
                <a class="navbar-brand w-100 h-100 m-0 p-0 d-flex align-items-center justify-content-center"
                   href="{{#if username}}/{{else}}/info{{/if}}">
                    <h1 class="m-0 display-4 text-primary text-uppercase">IronTrack</h1>
                </a>
            </div>
            <div class="col-lg-9">
                <nav class="navbar navbar-expand-lg bg-dark navbar-dark p-3 p-lg-0 px-lg-5">
                    <a class="navbar-brand d-block d-lg-none"
                       href="{{#if username}}/{{else}}/info{{/if}}">
                        <h1 class="m-0 display-4 text-primary text-uppercase">IronTrack</h1>
                    </a>
                    <!-- Navbar Toggler -->
                    <button type="button" class="navbar-toggler" data-bs-toggle="collapse"
                            data-bs-target="#navbarCollapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Collapsible Navbar Content -->
                    <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                        <!-- Left Side Navbar Buttons -->
                        <div class="navbar-nav">
                            {{#if username}}
                                <a href="/training" class="nav-item nav-link active">Add Training</a>
                                <a href="/records" class="nav-item nav-link">Records</a>
                                <a href="/find-users" class="nav-item nav-link">Find Users</a>
                                <a href="/sessions" class="nav-item nav-link">Training Sessions</a>
                                <a href="/stat" class="nav-item nav-link">Statistics and Analysis</a>
                                <a href="/register-training" class="nav-item nav-link">Register for training</a>
                            {{else}}
                                <a href="/info" class="nav-item nav-link active">Home</a>
                                <a href="about.html" class="nav-item nav-link">About</a>
                            {{/if}}
                        </div>

                        <!-- Right Side Navbar -->
                        <div class="navbar-nav ms-auto flex-column flex-lg-row">
                            {{#if username}}
                                <!-- Kui kasutajanimi on määratletud -->
                                <a href="/profile" class="nav-item nav-link">My Profile</a>
                                <button id="logout-btn" class="nav-item nav-link  btn btn-link p-0 logout">Log Out
                                </button>
                            {{else}}
                                <!-- Kui kasutajanimi puudub -->
                                <a href="/login?form=login" class="nav-item nav-link">Log In</a>
                                <a href="/login?form=signup" class="nav-item nav-link">Join Us</a>
                            {{/if}}
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
</header>




{{{body}}}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<script src="https://cdnjs.cloudflare.com/ajax/libs/waypoints/4.0.1/jquery.waypoints.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/counterup2/1.0.7/index.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/layout.js"></script>
<script src="/client.js"></script>

<script>

    document.addEventListener('DOMContentLoaded', function () {
        const logoutBtn = document.getElementById('logout-btn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', async function (event) {
                event.preventDefault();
                try {
                    const response = await fetch('/api/logout', {
                        method: 'POST',
                    });
                    if (response.ok) {
                        window.location.href = '/info';
                    } else {
                        alert('Logout failed.');
                    }
                } catch (error) {
                    console.error('Error during logout:', error);
                }
            });
        }
    });
</script>


</html>

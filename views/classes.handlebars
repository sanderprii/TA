<div class="container-fluid1 text-center">
    <!-- "Class Schedule" ja "Working Hours" sarnane päis -->
    <div class="mb-5">
        <h5 class="text-primary text-uppercase">Class Schedule</h5>
        <h1 class="display-3 text-uppercase mb-0">Working Hours</h1>
    </div>
    <div class="d-flex justify-content-end m-1">
        <button id="add-training-btn" class="btn btn-primary">Add Training</button>
    </div>
    <!-- Jätame alles senise funktsionaalse osa, lisame minimaalselt klasse -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <!-- Vasakul Previous Week nupp -->
        <button id="prev-week" class="btn btn-secondary">Previous Week</button>

        <!-- Keskel Current Week -->


        <!-- Paremal Next Week ja Add Training nupud -->
        <div class="d-flex align-items-center">
            <button id="next-week" class="btn btn-secondary me-2">Next Week</button>

        </div>
    </div>
    <span id="current-week" class="h5 text-center"></span>
    <!-- Päevade nupud väikese ekraani jaoks -->
    <div id="day-buttons" class="d-flex justify-content-between bg-dark rounded-pill" style="display:none;"></div>

    <!-- Siia renderdame JS-iga päevade kaupa tunniplaani -->
    <div id="schedule"></div>
</div>

<!-- Modal for search -->
<div class="modal fade" id="training-modal" tabindex="-1" role="dialog" aria-labelledby="trainingModalLabel"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">

                <h5 class="modal-title" id="trainingModalLabel">Training Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>


            </div>
            <div class="modal-body" id="training-modal-body">
                <!-- Training details will be injected here -->
            </div>
            <div class="modal-footer">

                <button type="button" id="edit-training-btn" class="btn btn-primary">Edit</button>
                <button type="button" id="save-training-btn" class="btn btn-success" style="display: none;">Save
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

            </div>
        </div>
    </div>
</div>
<!-- modal for training -->
<div class="modal fade" id="classModal" tabindex="-1" aria-labelledby="classModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="classModalLabel" class="modal-title">Class Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="classCapacityInfo"><strong>Registered:</strong> <span id="freeSpots"></span> / <strong>Class
                    capacity:</strong> <span id="classCapacity"></span></p>
                <p><strong>Training Name:</strong> <span id="modalTrainingName"></span></p>
                <p><strong>Time:</strong> <span id="modalTime"></span></p>
                <div id="classTrainer">
                    <p><strong>Trainer:</strong> <span id="modalTrainer"></span></p>
                </div>
                <div id="classLocation">
                    <p><strong>Location:</strong> <span id="modalLocation"></span></p>
                </div>
                <div class="bg-light border p-3" id="wodInfo">
                    <div id="wodName2" style="display: block">
                        <p><strong>Wod Name:</strong> <span id="wodName"></span></p>
                    </div>
                    <p><strong>Wod Type:</strong> <span id="wodType"></span></p>
                    <p><strong>Description:</strong>
                    <div id="modalDescription"></div>
                    </p>
                    <input type="hidden" id="modalClassId">
                </div>
                <p><strong>Registered for class</strong></p>
                <div id="classAttendance"></div>
            </div>


            <div class="modal-footer">
                <button type="button" id="delete-training-btn" class="btn btn-danger me-auto">Delete
                </button>
                <button id="showLeaderboard" type="button" class="btn btn-primary">Show Leaderboard</button>
                <button type="button" id="edit-class-btn" class="btn btn-primary">Edit</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for adding/editing training -->
<div class="modal fade" id="trainingModal" tabindex="-1" aria-labelledby="trainingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="training-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="trainingModalLabel">Add Training</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Form fields -->
                    <div class="mb-3">
                        <label for="trainingType" class="form-plan">Training Type*</label>
                        <select for="classTrainingType" id="classTrainingType" class="form-control">
                            <option value="">-- Select Training Type --</option>
                            <option value="WOD">WOD</option>
                            <option value="Weightlifting">Weightlifting</option>
                            <option value="Cardio">Cardio</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                        <div class="mb-3">
                            <label for="trainingName" class="form-plan">Training Name*</label>
                            <input type="text" class="form-control" id="trainingName" required>
                        </div>
                        <div class="mb-3">
                            <label for="trainingDate" class="form-plan">Date*</label>
                            <input type="date" class="form-control" id="trainingDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="trainingTime" class="form-plan">Time*</label>
                            <input type="time" class="form-control" id="trainingTime" required>
                        </div>
                        <div class="mb-3">
                            <label for="duration" class="form-plan">Duration (min)*</label>
                            <input type="number" class="form-control" id="duration">
                        </div>
                        <div class="mb-3">
                            <label for="trainer" class="form-plan">Trainer</label>
                            <input type="text" class="form-control" id="trainer">
                        </div>
                        <div class="mb-3">
                            <label for="memberCapacity" class="form-plan">Member Capacity*</label>
                            <input type="number" class="form-control" id="memberCapacity">
                        </div>
                        <div class="mb-3">
                            <label for="location" class="form-plan">Location</label>
                            <input type="text" class="form-control" id="location">
                        </div>
                        <div class="mb-3">
                            <label class="form-plan">Repeat Every Week</label><br>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="repeatWeekly" id="repeatYes"
                                       value="true">
                                <label class="form-plan" for="repeatYes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="repeatWeekly" id="repeatNo"
                                       value="false"
                                       checked>
                                <label class="form-plan" for="repeatNo">No</label>
                            </div>
                        </div>
                        <div class="mb-3">

                            <input type="search" id="wod-search" name="wod-search" class="form-control"
                                   placeholder="Search for WODs...">
                            <ul id="wod-search-results" class="list-group"
                                style="display: none; position: absolute; z-index: 1000;"></ul>
                        </div>

                        <div class="form-group">
                            <label class="form-plan" for="wod-name">WOD Name:</label>
                            <input type="text" id="wod-name" name="wod-name" class="form-control"
                                   placeholder="Enter WOD name">
                        </div>
                        <div class="form-group">
                            <label class="form-plan">WOD Type</label>
                            <div>
                                <label class="form-plan"><input type="radio" name="wod-type" value="For Time" checked>
                                    For
                                    Time</label>
                                <label class="form-plan"><input type="radio" name="wod-type" value="EMOM"> EMOM</label>
                                <label class="form-plan"><input type="radio" name="wod-type" value="Tabata">
                                    Tabata</label>
                                <label class="form-plan"><input type="radio" name="wod-type" value="AMRAP">
                                    AMRAP</label>
                            </div>
                        </div>


                        <div class="mb-3">
                            <label for="trainingDescription" class="form-plan">Training description</label>
                            <textarea class="form-control" id="trainingDescription" rows="5"></textarea>
                        </div>

                        <input type="hidden" id="trainingId">
                    </div>
                    <div class="modal-footer">

                        <button type="submit" class="btn btn-primary" id="save-training">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
            </form>
        </div>
    </div>
</div>

<!-- Leaderboard Modal -->
<div class="modal fade" id="leaderboardModal" tabindex="-1" aria-labelledby="leaderboardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg"> <!-- use modal-lg if you want a larger dialog -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="leaderboardModalLabel" class="modal-title">Leaderboard</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="leaderboardBody">
                <!-- We'll dynamically fill this with data (e.g., a table or list) -->
                <p>Loading leaderboard...</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Include gym.js -->
<script src="/gym.js"></script>

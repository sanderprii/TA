<div class="container-fluid p-5 text-center">
    <!-- "Class Schedule" ja "Working Hours" sarnane päis -->
    <div class="mb-5">
        <h5 class="text-primary text-uppercase">Class Schedule</h5>
        <h1 class="display-3 text-uppercase mb-0">Working Hours</h1>
    </div>
    <div class="d-flex justify-content-end m-1">
        <button id="add-training-btn" class="btn btn-primary">Add Training</button>
    </div>
    <!-- Jätame alles senise funktsionaalse osa, lisame minimaalselt klasse -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <!-- Vasakul Previous Week nupp -->
        <button id="prev-week" class="btn btn-secondary">Previous Week</button>

        <!-- Keskel Current Week -->


        <!-- Paremal Next Week ja Add Training nupud -->
        <div class="d-flex align-items-center">
            <button id="next-week" class="btn btn-secondary me-2">Next Week</button>

        </div>
    </div>
    <span id="current-week" class="h5 text-center"></span>
    <!-- Päevade nupud väikese ekraani jaoks -->
    <div id="day-buttons" class="d-flex justify-content-between bg-dark rounded-pill" style="display:none;"></div>

    <!-- Siia renderdame JS-iga päevade kaupa tunniplaani -->
    <div id="schedule"></div>
</div>

<!-- Modal for adding/editing training -->
<div class="modal fade" id="trainingModal" tabindex="-1" aria-labelledby="trainingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="training-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="trainingModalLabel">Add Training</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Form fields -->
                    <div class="mb-3">
                        <label for="trainingName" class="form-plan">Training Name*</label>
                        <input type="text" class="form-control" id="trainingName" required>
                    </div>
                    <div class="mb-3">
                        <label for="trainingDate" class="form-plan">Date*</label>
                        <input type="date" class="form-control" id="trainingDate" required>
                    </div>
                    <div class="mb-3">
                        <label for="trainingTime" class="form-plan">Time*</label>
                        <input type="time" class="form-control" id="trainingTime" required>
                    </div>
                    <div class="mb-3">
                        <label for="trainer" class="form-plan">Trainer</label>
                        <input type="text" class="form-control" id="trainer">
                    </div>
                    <div class="mb-3">
                        <label for="memberCapacity" class="form-plan">Member Capacity*</label>
                        <input type="number" class="form-control" id="memberCapacity">
                    </div>
                    <div class="mb-3">
                        <label for="location" class="form-plan">Location</label>
                        <input type="text" class="form-control" id="location">
                    </div>
                    <div class="mb-3">
                        <label class="form-plan">Repeat Every Week</label><br>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="repeatWeekly" id="repeatYes"
                                   value="true">
                            <label class="form-plan" for="repeatYes">Yes</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="repeatWeekly" id="repeatNo" value="false"
                                   checked>
                            <label class="form-plan for="repeatNo">No</label>
                        </div>
                    </div>
                    <input type="hidden" id="trainingId">
                </div>
                <div class="modal-footer">
                    <button type="button" id="delete-training-btn" class="btn btn-danger me-auto"
                            style="display: none;">Delete
                    </button>
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Include gym.js -->
<script src="/gym.js"></script>
